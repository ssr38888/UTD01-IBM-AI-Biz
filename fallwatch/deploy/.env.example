# Copy to .env and change every secret.
SITE_ADDRESS=https://fallwatch.example.org

POSTGRES_PASSWORD=change-me-db

# Comma-separated. Give each phone its own key so one can be revoked.
DEVICE_KEYS=change-me-phone-1,change-me-phone-2
VIEWER_KEYS=change-me-viewer

# Picture storage: "local" = volume on this LinuxONE box (default).
# "s3" = any S3-compatible store, e.g. IBM Cloud Object Storage or Ceph RGW.
STORAGE_BACKEND=local
S3_ENDPOINT=
S3_BUCKET=fallwatch-evidence
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
# s3 only: write-once evidence (Object Lock, compliance mode) for this many days.
# Set before the first start; the bucket must be created with Object Lock. 0 = off.
S3_RETENTION_DAYS=0

# Capture tuning (sent to the phones at start-up)
SNAPSHOT_INTERVAL_MS=750
BURST_INTERVAL_MS=300
PRE_EVENT_MS=5000
POST_EVENT_MS=5000
# 0 = upload only on falls. e.g. 60 = also one picture per minute.
HEARTBEAT_SEC=0
